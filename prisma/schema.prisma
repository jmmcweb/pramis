// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus { 
ACTIVE   
INACTIVE
PENDING 
}

enum AppointmentStatus {
PENDING
APPROVED
COMPLETED
CANCELLED
NO_SHOW
}

enum StaffRole {
ADMIN
MIDWIFE
}

enum UserRole {
SUPERADMIN
ADMIN
STAFF
MIDWIFE
USER
}

model User{
id            String            @id @default(uuid()) @db.Uuid   
referenceId   String?           @unique
email         String            @unique   
password      String   
status        AccountStatus     @default(PENDING) 
role          UserRole          @default(USER)
createdAt     DateTime          @default(now())   
updatedAt     DateTime          @updatedAt
profile       UserProfile?   
patient       Patient?   
appointments  Appointment[]   
 
@@map("users") 
}

model VerificationCode {
id        String   @id @default(uuid()) @db.Uuid
email     String   @unique
codeHash  String
expiresAt DateTime
createdAt DateTime @default(now())
}

model UserProfile {   
userprofileid             String    @id @default(uuid()) @db.Uuid   
userId        String      @unique @db.Uuid   
firstName     String   
middleName    String?   
lastName      String   
suffix        String?   
birthdate     DateTime   
phoneNumber   String   
houseNumber   String   
barangay      String   
city          String   
province      String   
zipCode       String   
validId       String?   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt   
user User     @relation(fields: [userId], references: [id], onDelete: Cascade) 
}

model Staff {
staffid       String      @id @default(uuid()) @db.Uuid   
referenceId   String?     @unique
firstName     String   
middleName    String?   
lastName      String
suffix        String?
email         String      @unique   
password      String   
role          StaffRole   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt   
medicalHistories MedicalHistory[]
}

model Service {   
serviceid     String      @id @default(uuid()) @db.Uuid   
name          String   
description   String
availability  Boolean     @default(true)   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt   
appointments Appointment[] 
}

model Event {
eventid       String      @id @default(uuid()) @db.Uuid   
name          String   
description   String   
startDate     DateTime   
endDate       DateTime   
status        Boolean     @default(true)   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt
}

model Patient {
patientid     String      @id @default(uuid()) @db.Uuid   
userId        String      @unique @db.Uuid   
allergies     String?   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt   
 user User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
 appointments Appointment[]
medicalHistories MedicalHistory[]   
walkInQueues WalkInQueue[] 
}

model Appointment {
appointmentid String      @id @default(uuid()) @db.Uuid   
patientId     String      @db.Uuid   
userId        String      @db.Uuid   
serviceId     String      @db.Uuid   
appointmentAt DateTime   
status        AppointmentStatus @default(PENDING)   
createdAt     DateTime    @default(now())   
updatedAt     DateTime    @updatedAt   
 patient Patient           @relation(fields: [patientId], references: [patientid])
 user User                 @relation(fields: [userId], references: [id])
 service Service           @relation(fields: [serviceId], references: [serviceid])
medicalHistory MedicalHistory?
}

model MedicalHistory {
medhisid       String     @id @default(uuid()) @db.Uuid   
patientId      String     @db.Uuid   
appointmentId  String     @unique @db.Uuid   
checkedById    String     @db.Uuid   
status         String   
bloodPressure  String   
oxygen         Decimal    @db.Decimal(5,2)   
height         Decimal    @db.Decimal(5,2)   
weight         Decimal    @db.Decimal(5,2)   
oxygenLevel    Decimal    @db.Decimal(5,2)   
diagnosis      String   
recommendation String?   
checkedDate    DateTime   
createdAt      DateTime   @default(now())   
updatedAt      DateTime   @updatedAt  
 patient Patient           @relation(fields: [patientId], references: [patientid])
 appointment Appointment   @relation(fields: [appointmentId], references: [appointmentid])
 checkedBy Staff           @relation(fields: [checkedById], references: [staffid])
}

model WalkInQueue {   
qid            String     @id @default(uuid()) @db.Uuid   
patientId     String      @db.Uuid   
queueType     String   
createdAt     DateTime    @default(now())   
 patient Patient           @relation(fields: [patientId], references: [patientid])
}

